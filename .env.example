# =============================================================================
# SIH Platform - Environment configuration
# Copy this file to .env (root, used by server) and .env.local (used by Next.js)
# =============================================================================

# ---- Database (Supabase Postgres) ----
# From Supabase: Project Settings -> Database -> Connection string (URI)
# Use the *Connection pooling* string (port 6543) for serverless workloads
# Use the *Direct connection* string (port 5432) for migrations
DATABASE_URL="postgresql://postgres:REPLACE_WITH_PASSWORD@db.REPLACE_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:REPLACE_WITH_PASSWORD@db.REPLACE_PROJECT_REF.supabase.co:5432/postgres"

# ---- Supabase project (for storage / future auth) ----
# Project Settings -> API
SUPABASE_URL="https://REPLACE_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="REPLACE_WITH_ANON_PUBLIC_KEY"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_WITH_ANON_PUBLIC_KEY"

# ---- JWT secrets (rotate these in production) ----
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_64_CHAR_STRING"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_STRING"
JWT_ACCESS_TTL_STUDENT="30m"
JWT_ACCESS_TTL_STAFF="2h"
JWT_REFRESH_TTL="30d"

# ---- AI provider (Claude) ----
ANTHROPIC_API_KEY="REPLACE_WITH_ANTHROPIC_KEY"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Server ----
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ---- Frontend (Next.js, NEXT_PUBLIC_ prefix exposes to browser) ----
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
